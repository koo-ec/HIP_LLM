# Keep research sources and generated machine-readable artefacts stable across
# platforms so checksums do not change on Windows checkouts.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.sh text eol=lf
*.ipynb text eol=lf

# Matplotlib-generated path data conventionally contains trailing spaces.
*.svg -whitespace
